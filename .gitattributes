# LF on checkin and checkout, as .editorconfig's end_of_line = lf.

* text=auto eol=lf
# Shell scripts break with CRLF; declared, not left to text detection.
*.sh text eol=lf
.mise/tasks/** text eol=lf

# Lock files are reviewable text but generated; collapse them in GitHub review.
pnpm-lock.yaml linguist-generated
mise.lock linguist-generated
.mise/locks/** linguist-generated

# Images (README screenshots), archives.
*.png binary
*.jpg binary
*.svg text
*.zip binary
*.gz binary
