# ShellCheck config — strict defaults for bash.
# Docs: https://www.shellcheck.net/wiki/Directive
#       https://www.shellcheck.net/wiki/Optional
#
# Koalaman's guidance: do NOT use `enable=all`. Optional checks are
# subjective and some conflict. Enumerate the ones we want, one per
# line, so every addition is a deliberate policy decision.

# Target dialect. Files without a shebang (sourced libraries) inherit
# this instead of defaulting to `sh`.
shell=bash

# Report every severity, `style` included (ShellCheck's lowest level);
# raising it silences fixable issues.
severity=style

# External sources followed. Without this, every `source` / `.` is
# a blind spot unless it carries a per-line `# shellcheck source=...`.
external-sources=true

# --- Optional checks we opt into, rationale per line ---

# Flag `case` without a default `*)` branch — unhandled inputs are bugs.
enable=add-default-case

# Flag `[ $x ]` and `[[ $x ]]` — fragile and usually wrong;
# prefer `[[ -n "$x" ]]` / `[[ -z "$x" ]]`.
enable=avoid-nullary-conditions

# Flag exit codes masked beyond the default checks (SC2312), e.g.
# the failure inside `rm -r "$(get_dir)/home"`. Pairs with `set -e`,
# which misses a failed command substitution used as an argument.
enable=check-extra-masked-returns

# Flag `set -e` configurations where the exit-on-error guarantee is
# silently dropped (command in `if`, `while`, function called from
# a conditional, etc.).
enable=check-set-e-suppressed

# Catch `$FOO` where `FOO` is never assigned — classic typo killer
# (`$PAHT` instead of `$PATH`, etc.).
enable=check-unassigned-uppercase

# Push users from `which` toward `command -v` (portability + speed).
enable=deprecate-which

# Quote even variables that cannot word-split (SC2248) — uniform
# quoting, no judgement calls.
enable=quote-safe-variables

# Nudge toward `[[ ]]` over `[ ]` in bash files (POSIX-sh files
# will fire this; override inline with `# shellcheck shell=sh` there).
enable=require-double-brackets

# Warn on `$var` vs `${var}` — brace form is less ambiguous
# alongside concatenation. Set on because shellcheck default is quiet.
enable=require-variable-braces

# --- No blanket disables. Project-level exceptions belong here
#     (with one-line reasons); scoped exceptions belong inline on
#     the offending line with `# shellcheck disable=SCxxxx  # reason`. ---
