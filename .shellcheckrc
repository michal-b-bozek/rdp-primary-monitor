# ShellCheck config for bash. Optional checks are listed one by one: `enable=all` turns on
# subjective checks, some of which conflict.

# Sourced libraries without a shebang get bash, not `sh`.
shell=bash

# Report `style` too; a higher level hides fixable issues.
severity=style

# Follow `source` without a per-line `# shellcheck source=...`.
external-sources=true

# --- Optional checks ---

# A `case` without `*)` leaves inputs unhandled.
enable=add-default-case

# `[[ $x ]]` is fragile; use `[[ -n "$x" ]]` / `[[ -z "$x" ]]`.
enable=avoid-nullary-conditions

# SC2312: `set -e` misses a failed command substitution used as an argument.
enable=check-extra-masked-returns

# Flags code where `set -e` is silently off (in `if`, `while`, a function called from a
# conditional).
enable=check-set-e-suppressed

# Catches typos such as `$PAHT`.
enable=check-unassigned-uppercase

enable=deprecate-which

# SC2248: uniform quoting, no judgement calls.
enable=quote-safe-variables

# POSIX-sh files override it inline with `# shellcheck shell=sh`.
enable=require-double-brackets

# Braces are unambiguous next to concatenation.
enable=require-variable-braces

# Project-wide exceptions go here with a one-line reason; scoped ones go inline as
# `# shellcheck disable=SCxxxx  # reason`.
