root = true

[*]
indent_style = space
indent_size = 2
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

# Markdown carries meaningful trailing whitespace (two trailing spaces = <br>).
[*.md]
trim_trailing_whitespace = false

# Shell: shfmt reads these keys when run without flags (Google style). The mise file
# tasks have no extension, so their directory gets its own section.
[*.sh]
shell_variant = bash
switch_case_indent = true
space_redirects = true
binary_next_line = false
keep_padding = false
function_next_line = false

[.mise/tasks/**]
shell_variant = bash
switch_case_indent = true
space_redirects = true
binary_next_line = false
keep_padding = false
function_next_line = false
