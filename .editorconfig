# EditorConfig — cross-editor baseline.
# Spec: https://editorconfig.org/

root = true

[*]
indent_style = space
indent_size = 2
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

# Markdown carries meaningful trailing whitespace (two trailing spaces = <br>).
[*.md]
trim_trailing_whitespace = false
