#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Michał Bogusław Bożek
# SPDX-License-Identifier: MIT
#MISE description="Build a test VM from scratch (Fedora network install + kickstart); ends powered off"
#USAGE arg "<vm>" help="f43 (Fedora 43, GNOME 49) or f44 (Fedora 44, GNOME 50)" {
#USAGE   choices "f43" "f44"
#USAGE }
#
# Installs Fedora Workstation into a new qemu:///session domain: no root, no ISO, the
# installer and packages come from the Fedora mirrors (a few GB, a long download). The
# kickstart is rendered with fresh credentials kept in the VM's state directory, outside the
# repository. Refuses to touch an existing VM: run vm:destroy first.
set -euo pipefail
shopt -s inherit_errexit
IFS=$'\n\t'

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly SCRIPT_DIR
readonly VM_TOOLS_DIR="${SCRIPT_DIR}/../../../tools/vm"
# shellcheck source=tools/vm/lib.sh
source "${VM_TOOLS_DIR}/lib.sh"

readonly INSTALL_TIMEOUT_MINUTES=90

# The temporary directory holds the rendered kickstart (password hash, RDP credentials).
tmp=
cleanup() {
  if [[ -n "${tmp}" ]]; then rm -rf -- "${tmp}"; fi
}
on_signal() {
  local sig="$1"
  cleanup
  trap - "${sig}" EXIT
  kill -s "${sig}" "$$"
}

# render_kickstart <template> <output> — fill the @…@ placeholders. The guest files travel
# inside the kickstart as base64, so nothing depends on where the installer keeps extra
# initrd files. Replacements are quoted so bash's patsub_replacement never treats `&` in a
# value as the matched text.
render_kickstart() {
  local ks password_hash public_key guest_setup rdp_credentials
  ks="$(< "$1")"
  password_hash="$(openssl passwd -6 -stdin < "${RDPPM_VM_STATE_DIR}/tester-password")"
  public_key="$(< "${RDPPM_VM_STATE_DIR}/ssh-key.pub")"
  guest_setup="$(base64 --wrap=0 < "${VM_TOOLS_DIR}/rdppm-guest-setup.sh")"
  rdp_credentials="$(base64 --wrap=0 < "${RDPPM_VM_STATE_DIR}/rdp-credentials")"
  ks="${ks//@RELEASE@/"${RDPPM_VM_RELEASE}"}"
  ks="${ks//@INSTALL_TREE@/"${RDPPM_VM_INSTALL_TREE}"}"
  ks="${ks//@HOSTNAME@/"${RDPPM_VM_NAME}"}"
  ks="${ks//@TESTER_PASSWORD_HASH@/"${password_hash}"}"
  ks="${ks//@SSH_PUBLIC_KEY@/"${public_key}"}"
  ks="${ks//@GUEST_SETUP_B64@/"${guest_setup}"}"
  ks="${ks//@RDP_CREDENTIALS_B64@/"${rdp_credentials}"}"
  if [[ "${ks}" =~ @[A-Z0-9_]+@ ]]; then
    printf 'error: unfilled placeholder left in %s\n' "$1" >&2
    return 65
  fi
  (
    umask 077
    printf '%s\n' "${ks}" > "$2"
  )
}

# generate_credentials — fresh tester password, RDP credentials and ssh key for this build.
generate_credentials() {
  rm -rf -- "${RDPPM_VM_STATE_DIR}"
  mkdir -p -- "${RDPPM_VM_STATE_DIR}"
  chmod 0700 -- "${RDPPM_VM_STATE_DIR}"
  (
    umask 077
    openssl rand -hex 16 > "${RDPPM_VM_STATE_DIR}/tester-password"
    local rdp_password
    rdp_password="$(openssl rand -hex 16)"
    printf '%s\n%s\n' "${RDPPM_RDP_USER}" "${rdp_password}" > "${RDPPM_VM_STATE_DIR}/rdp-credentials"
  )
  ssh-keygen -q -t ed25519 -N '' -C "${RDPPM_VM_NAME}" -f "${RDPPM_VM_STATE_DIR}/ssh-key"
}

main() {
  rdppm_vm_resolve "${usage_vm:?}"
  rdppm_require_cmd virsh virt-install passt openssl ssh-keygen

  rdppm_vm_lookup
  if [[ "${RDPPM_VM_EXISTS}" == "true" ]]; then
    printf 'error: %s already exists; remove it first with: mise run vm:destroy %s\n' \
      "${RDPPM_VM_NAME}" "${usage_vm}" >&2
    exit 73
  fi

  trap cleanup EXIT
  trap 'on_signal INT' INT
  trap 'on_signal TERM' TERM
  trap 'on_signal HUP' HUP
  tmp="$(mktemp -d)"

  generate_credentials
  render_kickstart "${VM_TOOLS_DIR}/kickstart.ks.in" "${tmp}/ks.cfg"

  printf 'Installing %s (Fedora %s); progress: %s\n' "${RDPPM_VM_NAME}" "${RDPPM_VM_RELEASE}" \
    "${RDPPM_VM_STATE_DIR}/console.log" >&2
  # Two virtio display heads stand in for two physical monitors. The resolution below reaches
  # only Virtual-1 (1920x1080); Virtual-2, forced on by the kernel argument, comes up at QEMU's
  # 5120x2160 and Mutter scales it by 2.67, a HiDPI monitor next to a normal one. passt
  # forwards RDP and ssh on the host loopback only. The kickstart ends with poweroff and
  # --noreboot keeps the VM off; the bounded wait turns a halted installer (failed %post,
  # broken mirror) into an error.
  if ! virt-install --connect "${RDPPM_LIBVIRT_URI}" \
    --name "${RDPPM_VM_NAME}" \
    --osinfo "${RDPPM_VM_OSINFO}" \
    --memory 4096 --vcpus 4 --cpu host-passthrough \
    --disk size=30,format=qcow2,bus=virtio \
    --location "${RDPPM_VM_INSTALL_TREE}" \
    --initrd-inject "${tmp}/ks.cfg" \
    --extra-args "inst.ks=file:/ks.cfg console=tty0 console=ttyS0,115200n8" \
    --network "type=user,backend.type=passt,model.type=virtio,portForward0.proto=tcp,portForward0.address=127.0.0.1,portForward0.range0.start=${RDPPM_VM_RDP_PORT},portForward0.range0.to=3389,portForward1.proto=tcp,portForward1.address=127.0.0.1,portForward1.range0.start=${RDPPM_VM_SSH_PORT},portForward1.range0.to=22" \
    --video model.type=virtio,model.heads=2 \
    --xml ./devices/video/model/resolution/@x=1920 \
    --xml ./devices/video/model/resolution/@y=1080 \
    --graphics spice \
    --serial "file,path=${RDPPM_VM_STATE_DIR}/console.log" \
    --noautoconsole --noreboot --wait "${INSTALL_TIMEOUT_MINUTES}"; then
    printf 'error: installing %s failed or took over %s minutes; see %s, then: mise run vm:destroy %s\n' \
      "${RDPPM_VM_NAME}" "${INSTALL_TIMEOUT_MINUTES}" "${RDPPM_VM_STATE_DIR}/console.log" "${usage_vm}" >&2
    exit 75
  fi

  printf '%s installed and powered off. Next: mise run vm:start %s\n' \
    "${RDPPM_VM_NAME}" "${usage_vm}" >&2
}

main "$@"
