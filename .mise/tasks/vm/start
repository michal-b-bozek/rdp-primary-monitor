#MISE description="Boot a test VM and wait until its Desktop Sharing (RDP) server listens"
#USAGE arg "<vm>" help="f43 (Fedora 43, GNOME 49) or f44 (Fedora 44, GNOME 50)" {
#USAGE   choices "f43" "f44"
#USAGE }
set -euo pipefail
shopt -s inherit_errexit
IFS=$'\n\t'

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly SCRIPT_DIR
# shellcheck source=tools/vm/lib.sh
source "${SCRIPT_DIR}/../../../tools/vm/lib.sh"

readonly BOOT_TIMEOUT=300
readonly RDP_TIMEOUT=120

# wait_rdp — the RDP listener appears once the autologin session has run rdppm-guest-setup.
wait_rdp() {
  local started="${SECONDS}" listeners
  while true; do
    # shellcheck disable=SC2310  # ssh fails while the guest boots: "not listening yet"
    listeners="$(rdppm_vm_ssh_quiet "ss -Hltn 'sport = :3389'")" || listeners=
    if [[ -n "${listeners}" ]]; then return 0; fi
    if ((SECONDS - started >= RDP_TIMEOUT)); then
      printf 'error: nothing listens on port 3389 in %s after %ss; check the guest log:\n' \
        "${RDPPM_VM_NAME}" "${RDP_TIMEOUT}" >&2
      printf '  mise run vm:ssh %s -- journalctl --user -t rdppm-guest-setup.desktop\n' \
        "${RDPPM_VM_NAME#rdppm-}" >&2
      return 69
    fi
    sleep 3
  done
}

main() {
  rdppm_vm_resolve "${usage_vm:?}"
  rdppm_require_cmd virsh ssh
  rdppm_vm_require_exists
  rdppm_vm_require_ssh_key

  local state
  state="$(rdppm_vm_state)"
  case "${state}" in
    running) ;;
    paused) rdppm_virsh resume "${RDPPM_VM_NAME}" > /dev/null ;;
    pmsuspended) rdppm_virsh dompmwakeup "${RDPPM_VM_NAME}" > /dev/null ;;
    "in shutdown")
      printf 'error: %s is shutting down; wait, or run: mise run vm:stop %s --force\n' \
        "${RDPPM_VM_NAME}" "${usage_vm}" >&2
      return 75
      ;;
    *) rdppm_virsh start "${RDPPM_VM_NAME}" > /dev/null ;;
  esac
  rdppm_vm_wait_ssh "${BOOT_TIMEOUT}"
  wait_rdp

  printf '%s is up: RDP 127.0.0.1:%s (mise run vm:connect %s), ssh 127.0.0.1:%s (mise run vm:ssh %s)\n' \
    "${RDPPM_VM_NAME}" "${RDPPM_VM_RDP_PORT}" "${usage_vm}" "${RDPPM_VM_SSH_PORT}" "${usage_vm}" >&2
}

main "$@"
