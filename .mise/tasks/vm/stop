#MISE description="Shut a test VM down cleanly (in-guest poweroff, ACPI fallback); --force pulls the plug"
#USAGE arg "<vm>" help="f43 (Fedora 43, GNOME 49) or f44 (Fedora 44, GNOME 50)" {
#USAGE   choices "f43" "f44"
#USAGE }
#USAGE flag "--force" help="Power off immediately (virsh destroy; the disk stays)"
set -euo pipefail
shopt -s inherit_errexit
IFS=$'\n\t'

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly SCRIPT_DIR
# shellcheck source=tools/vm/lib.sh
source "${SCRIPT_DIR}/../../../tools/vm/lib.sh"

readonly SHUTDOWN_TIMEOUT=120

main() {
  rdppm_vm_resolve "${usage_vm:?}"
  rdppm_require_cmd virsh
  rdppm_vm_require_exists

  local state
  state="$(rdppm_vm_state)"
  if [[ "${state}" == "shut off" ]]; then
    printf '%s is already shut off\n' "${RDPPM_VM_NAME}" >&2
    return 0
  fi
  if [[ "${usage_force:-false}" == "true" ]]; then
    rdppm_vm_force_off
    return 0
  fi
  rdppm_require_cmd ssh
  # A paused or suspended guest runs no code: wake it so it can act on the poweroff request.
  case "${state}" in
    paused) rdppm_virsh resume "${RDPPM_VM_NAME}" > /dev/null ;;
    pmsuspended) rdppm_virsh dompmwakeup "${RDPPM_VM_NAME}" > /dev/null ;;
    *) ;;
  esac

  # GNOME may suspend or prompt on an ACPI request, so ask the guest itself first. ssh may fail
  # as the guest drops the connection going down; the extra ACPI request, or virsh refusing it,
  # is then harmless. The domain state decides success.
  # shellcheck disable=SC2310  # failure only selects the ACPI fallback
  if [[ ! -r "${RDPPM_VM_STATE_DIR}/ssh-key" ]] || ! rdppm_vm_ssh_quiet sudo systemctl poweroff; then
    rdppm_virsh shutdown "${RDPPM_VM_NAME}" > /dev/null 2>&1 || true
  fi
  local started="${SECONDS}"
  while true; do
    state="$(rdppm_vm_state)"
    if [[ "${state}" == "shut off" ]]; then return 0; fi
    if ((SECONDS - started >= SHUTDOWN_TIMEOUT)); then
      printf 'error: %s still running after %ss; retry with --force\n' \
        "${RDPPM_VM_NAME}" "${SHUTDOWN_TIMEOUT}" >&2
      return 75
    fi
    sleep 2
  done
}

main "$@"
