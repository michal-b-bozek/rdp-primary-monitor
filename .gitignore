# --- Credentials ------------------------------------------------------------
# A project .npmrc could only carry registry auth (pnpm 12 reads its settings from
# pnpm-workspace.yaml); keep that in ~/.npmrc.
*.key
*.pem
auth.json
.npmrc
.env
.env.*
!.env.example

# --- mise -------------------------------------------------------------------
# Per-developer overrides, in every file name mise reads.
mise.local.toml
.mise.local.toml
mise.*.local.toml
# Per-developer lefthook overrides.
lefthook-local.yml
.lefthook-local.yml
# lychee link-check cache (mise run docs:check).
.lycheecache

# --- Agent session state ----------------------------------------------------
# The task record: per-session working notes, never committed.
.task-record.md
# Claude Code's per-user settings.
.claude/settings.local.json

# --- Node dev tooling -------------------------------------------------------
node_modules/
.pnpm-store/
*.tsbuildinfo
.eslintcache

# --- Build output -----------------------------------------------------------
# Packed extension zips (gnome-extensions pack) and the schema cache GNOME compiles itself.
build/
dist/
*.zip
src/schemas/gschemas.compiled

# --- OS junk, editor state, logs --------------------------------------------
.DS_Store
.Trash-*
.nfs*
.idea/
.vscode/
*.swp
*.swo
*~
*.orig
*.rej
*.log
